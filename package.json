{
  "name": "krewlimber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-api.mjs && node scripts/check-function.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "admin:create": "tsx scripts/create-admin.ts",
    "husky": "husky",
    "prepare": "husky",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:boards": "tsx scripts/seed-boards.ts",
    "supabase:check": "tsx scripts/check-supabase.ts",
    "supabase:migrate": "tsx scripts/migrate-postgres.ts",
    "supabase:import": "tsx scripts/import-sqlite.ts",
    "supabase:smoke": "tsx scripts/smoke-supabase.ts"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "lucide-react": "1.69.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.14.0"
}
